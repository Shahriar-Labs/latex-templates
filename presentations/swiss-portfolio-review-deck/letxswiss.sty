\ProvidesPackage{letxswiss}[2026/09/02 LetX international style deck theme]

% Swiss/international style: white ground, one red, a strict left margin that
% everything aligns to, and no decoration whatsoever. The grid is the design.
\RequirePackage{tikz}
\RequirePackage{tgheros}
\renewcommand{\familydefault}{\sfdefault}

\definecolor{ink}{HTML}{111111}
\definecolor{paper}{HTML}{FFFFFF}
\definecolor{accent}{HTML}{D7263D}
\definecolor{rule}{HTML}{111111}
\definecolor{muted}{HTML}{6E6E6E}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamercolor{background canvas}{bg=paper}
\setbeamercolor{normal text}{fg=ink}
\setbeamercolor{structure}{fg=accent}

% A heavy rule above the title, flush left. Same position on every slide, which
% is what makes a deck feel built rather than assembled.
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamertemplate{frametitle}{%
  \vspace{1.0em}%
  {\color{rule}\rule{\textwidth}{2.2pt}}\par\vspace{0.45em}
  {\usebeamerfont{frametitle}\color{ink}\insertframetitle}\par\vspace{0.3em}}

% Numbered items that align to the same margin as everything else.
\newcommand{\gridnum}[2]{%
  \noindent{\color{accent}\bfseries\large #1}\hspace{0.8em}%
  \parbox[t]{0.82\textwidth}{\vspace{-1.15em}#2}\par\vspace{0.7em}}

\newcommand{\bignumber}[2]{%
  \vspace{0.3em}
  {\fontsize{60}{64}\selectfont\bfseries\color{ink}#1}\par\vspace{0.35em}
  {\color{accent}\rule{3em}{2.2pt}}\par\vspace{0.5em}
  {\small\color{muted}\parbox{0.76\textwidth}{#2}}}

\newcommand{\titleslide}{%
  \begin{frame}[plain]
    \vspace{1.6em}
    {\color{rule}\rule{\textwidth}{4pt}}\par\vspace{1.2em}
    {\fontsize{38}{42}\selectfont\bfseries\color{ink}\inserttitle}\par\vspace{0.5em}
    {\large\color{accent}\insertsubtitle}\par\vspace{2.2em}
    {\small\color{muted}\insertauthor\hfill\insertdate}
  \end{frame}}

\newcommand{\sectionslide}[1]{%
  \begin{frame}[plain]
    \vspace{3.2em}
    {\color{accent}\rule{\textwidth}{4pt}}\par\vspace{0.9em}
    {\fontsize{30}{34}\selectfont\bfseries\color{ink}#1}
  \end{frame}}

\endinput
