# Gera a lista de abreviaturas e siglas (pacote nomencl) automaticamente.
# Usado pelo LetX e pelo comando: latexmk -pdf main.tex
add_cus_dep('nlo', 'nls', 0, 'makenlo2nls');
sub makenlo2nls {
    system("makeindex -s nomencl.ist -o \"$_[0].nls\" \"$_[0].nlo\"");
}
push @generated_exts, 'nlo', 'nls';
